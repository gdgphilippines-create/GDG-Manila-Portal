rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // 1. The "Remote Control" document
    match /appConfig/global {
      // Allows anyone to listen for the "activeRoute" change
      allow read: if true;
      
      // ONLY allow writes if the user is an admin.
      // For now, while you test, you can use your specific UID or email.
      allow write: if request.auth != null && request.auth.token.email == "your-email@example.com";
    }

    // 2. The Registrations collection
    match /registrations/{email} {
      // Completely locked to the public. 
      // Your Cloud Run Backend (Admin SDK) will still have full access.
      allow read, write: if false;
    }
    
    // 3. Default deny (Security Best Practice)
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
